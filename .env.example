# Mag.IA - variaveis locais da stack Docker
# Copie este arquivo para .env e preencha os valores reais.

TIMEZONE=America/Sao_Paulo

# Postgres do n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=n8n

# Redis
REDIS_PASSWORD=troque-esta-senha

# n8n
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=gere-uma-chave-fixa-com-32-ou-mais-caracteres
N8N_LOG_LEVEL=info

# Supabase usado pelo n8n
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=cole-a-anon-key
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-apenas-no-n8n

# IA
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_LIMIT=20
GEMINI_MAX_OUTPUT_TOKENS=220
TENANT_CATALOG_ENABLED=true
DEFAULT_TENANT_SLUG=jiw

# Telegram
# Padrao por cliente: TELEGRAM_BOT_TOKEN_{SLUG_EM_CAIXA_ALTA}
# Exemplos: TELEGRAM_BOT_TOKEN_CLINICA_ALPHA, TELEGRAM_BOT_TOKEN_BRONZEAMENTO_DOM_IAN
TELEGRAM_BOT_TOKEN_SLUG_DO_CLIENTE=
# Bucket privado para arquivos recebidos. Crie com a migration 014 antes de ativar.
TELEGRAM_MEDIA_BUCKET=channel-media
# Limite por arquivo: 10 MB. Arquivos maiores ficam apenas como placeholder no painel.
TELEGRAM_MEDIA_MAX_BYTES=10485760

# Instagram Graph API - futuro adapter multi-tenant
# Nao usar login/senha do Instagram no sistema. Use token oficial da Meta.
INSTAGRAM_VERIFY_TOKEN_SLUG_DO_CLIENTE=gere-um-token-de-verificacao
INSTAGRAM_PAGE_ACCESS_TOKEN_SLUG_DO_CLIENTE=

# Evolution API - usado quando ativarmos WhatsApp
EVOLUTION_PORT=8080
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=troque-esta-senha
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_SERVER_URL=http://localhost:8080
N8N_WEBHOOK_BASE=http://n8n:5678

